# Whiskey Vault Configuration
PORT=3000
JWT_SECRET=whiskey_vault_super_secure_jwt_secret_key_2026

# Storage Mode (auto-detects: if MONGODB_URI is empty or unreachable, falls back to embedded local storage)
MONGODB_URI=

# IPFS / Pinata Configuration (optional: if omitted, files are saved locally with valid SHA-256 / CID)
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=

# Ethereum / Web3 Configuration (optional: if omitted, built-in cryptographically verified local ledger is used)
INFURA_ENDPOINT=
PRIVATE_KEY=
CONTRACT_ADDRESS=

